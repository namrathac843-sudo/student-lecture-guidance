# ------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file to Git.
# ------------------------------------------------------------------

# Application signing secret. Replace with a unique random value before deployment.
SECRET_KEY=replace-with-a-unique-random-secret-before-deployment

# Where uploaded project files are stored on the server
UPLOAD_FOLDER=uploads

# Persistent server-side application data (users, approvals and API records)
DATA_FILE=instance/pgmp-data.json

# Bearer token lifetime in seconds (default: 12 hours)
TOKEN_TTL_SECONDS=43200

# Maximum size of ONE uploaded file, in megabytes
MAX_UPLOAD_MB=10

# ------------------------------------------------------------------
# College email / USN rules. Adjust these to match your institution.
# ------------------------------------------------------------------
COLLEGE_EMAIL_DOMAIN=gat.ac.in

# USN format used by the college, e.g. 1GA21CS001
# ^[0-9]{1}[A-Z]{2}[0-9]{2}[A-Z]{2}[0-9]{3}$
USN_PATTERN=^[0-9]{1}[A-Z]{2}[0-9]{2}[A-Z]{2}[0-9]{3}$

# If "true", students MUST use <USN>@<COLLEGE_EMAIL_DOMAIN>
REQUIRE_STUDENT_USN_EMAIL=true

# If "true", lecturers/alumni must also use @<COLLEGE_EMAIL_DOMAIN>.
# If "false", any valid email address is accepted for those roles.
STRICT_EMAIL_FOR_ALL_ROLES=false

# Admin accounts are created privately with: python create_admin.py
FLASK_DEBUG=false

# Firebase Spark / Firestore shared database
# Enable after creating Firestore and downloading a private service account key.
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS=serviceAccountKey.json

# College timezone used for server-side project deadline validation
APP_TIMEZONE=Asia/Kolkata

# Comma-separated allowed frontend origins for Firebase Hosting + Render
CORS_ALLOWED_ORIGINS=http://localhost:5000
